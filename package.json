{
  "name": "sync-layer-server",
  "version": "1.0.0",
  "description": "Service that continuously synchronizes geospatial layer data from a third-party GraphQL API into a remote PostgreSQL database",
  "main": "./src/index.ts",
  "scripts": {
    "test:unit": "vitest run --coverage.enabled=false --project unit",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true  node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles ./package.json dist",
    "clean": "rimraf dist",
    "prepare": "node .husky/install.mjs",
    "typeorm": "ts-node --esm ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:generate -d src/dal/db.data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/dal/db.data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/dal/db.data-source.ts"
  },
  "directories": {
    "test": "tests"
  },
  "author": "MapColonies",
  "license": "ISC",
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/error-express-handler": "^4.0.0",
    "@map-colonies/express-access-log-middleware": "^4.1.0",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "^1.0.0",
    "@map-colonies/schemas": "^1.18.0",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "axios": "^1.15.2",
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "heap-js": "^2.7.1",
    "http-status-codes": "^2.3.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@map-colonies/commitlint-config": "^2.0.0",
    "@map-colonies/eslint-config": "^8.0.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@map-colonies/tsconfig": "^2.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vitest/ui": "^4.0.18",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "docker-compose": "^1.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-jest": "^28.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
