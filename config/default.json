{
  "telemetry": {
    "metrics": {},
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false,
      "opentelemetryOptions": {
        "enabled": false
      }
    }
  },
  "server": {
    "port": 8080,
    "request": {
      "payload": {
        "limit": "1mb"
      }
    },
    "response": {
      "compression": {
        "enabled": true,
        "options": null
      }
    }
  },
  "sync": {
    "layerQueries": {
      "obstacles": "query { obstacles { createdBy creationTime deleted entityVersion geography { coordinates { latitude longitude } graphicsObjectKind { value } height obstacleHeightsRange { displayName } } id identifiers { essence { displayName value } name number } lastUpdateTime lastUpdatedBy } }"
    },
    "syncIntervalMs": 500,
    "pollIntervalMs": 600000,
    "pageSize": 1000,
    "thirdPartyBaseUrl": "http://mock-third-party/graphql",
    "realityId": 0,
    "requestingSystem": "sync-layer-server_prod",
    "requestingSystemName": "sync-layer-server",
    "useDeleteEntities": true,
    "authToken": ""
  },
  "db": {
    "type": "postgres",
    "host": "localhost",
    "port": 5432,
    "database": "sync_layer_dev",
    "username": "postgres",
    "password": "postgres",
    "enableSslAuth": false,
    "sslPaths": {
      "ca": "",
      "key": "",
      "cert": ""
    }
  }
}
